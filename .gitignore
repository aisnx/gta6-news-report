# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 项目本地工具与个人文档（不随网站公开）
.claude/
.agents/
business-plan.md
mvp-v1.html
skills-lock.json

# Word 锁文件
~$*

# 构建时生成（prebuild 钩子），不入库
/public/search-index.json
/public/llms.txt
/public/llms-full.txt
