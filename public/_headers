# Static assets: content-hashed filenames, cache permanently
/_next/*
  Cache-Control: public, max-age=31536000, immutable

# Cover images: cache one day
/covers/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# Everything else (HTML + JSON/TXT/XML payloads): browser revalidates every time,
# CDN edge may cache 1 hour with background revalidation
/*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
