# Static assets: content-hashed filenames, cache permanently
/_next/*
  Cache-Control: public, max-age=31536000, immutable

# Cover images: cache one day
/covers/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# Everything else (HTML + JSON/TXT/XML payloads): no edge caching so new
# deployments go live immediately; browser revalidates every time
/*
  Cache-Control: public, max-age=0, must-revalidate
